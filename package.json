{
  "name": "@silverassist/agents-toolkit",
  "version": "2.6.0",
  "description": "Reusable AI agent prompts for development workflows with Jira integration — supports GitHub Copilot, Claude Code, and Codex",
  "author": "Santiago Ramirez",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/agents-toolkit.git"
  },
  "homepage": "https://github.com/SilverAssist/agents-toolkit#readme",
  "bugs": {
    "url": "https://github.com/SilverAssist/agents-toolkit/issues"
  },
  "keywords": [
    "github-copilot",
    "claude-code",
    "claude",
    "codex",
    "agents-toolkit",
    "ai-agent",
    "developer-workflow",
    "vscode",
    "jira",
    "atlassian",
    "git",
    "pull-request",
    "code-review"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "agents-toolkit": "bin/cli.js"
  },
  "files": [
    "bin",
    "src/index.js",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install-prompts": "node bin/cli.js install",
    "test": "node --test",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:prompts": "node scripts/validate-prompts.mjs",
    "check": "npm run format:check && npm run lint:md && npm run validate:prompts && npm test",
    "prepare": "node -e \"if(!process.env.CI&&process.env.NODE_ENV!=='production')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "js-yaml": "5.2.3",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  }
}
